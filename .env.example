# Локальный сервер FluentPath
PORT=3001
HOST=127.0.0.1

# По умолчанию используется официальный OpenAI.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Если используете TokenWave, переключите AI_PROVIDER и добавьте свой ключ.
TOKENWAVE_API_KEY=
TOKENWAVE_BASE_URL=https://tokenwave.ru/v1
